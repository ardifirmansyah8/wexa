# Copy this file to `.env` (in the project root or backend/) and fill in the
# values from your CognoDB Cloud console. NEVER commit the real .env file.

# The bolt+s:// connection URI from CognoDB Cloud.
NEO4J_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud

# The database user (CognoDB creates "cognodb" by default).
NEO4J_USER=cognodb

# The generated password shown ONCE when you created the instance.
NEO4J_PASSWORD=<your-password>

# CognoDB free tier uses the default database name.
NEO4J_DATABASE=neo4j

# Comma-separated origins allowed to call the API (the frontend dev server,
# and your deployed frontend URL once hosted).
CORS_ORIGINS=http://localhost:5173

# Optional: a free TMDB API key (v3 auth) used only by seed/enrich_posters.py
# to fetch real poster images. https://www.themoviedb.org/settings/api
TMDB_API_KEY=
